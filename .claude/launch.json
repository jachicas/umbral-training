{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "umbral-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "umbral-api",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd ../umbral-training-api && composer dev"
      ],
      "port": 8000,
      "autoPort": false
    },
    {
      "name": "umbral-api-localdb",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd ../umbral-training-api/public && DB_URL= php -S 127.0.0.1:8000 ../vendor/laravel/framework/src/Illuminate/Foundation/resources/server.php"
      ],
      "port": 8000,
      "autoPort": false
    }
  ]
}
