# Server-only (no NEXT_PUBLIC_): sign-in runs in Server Actions and the API is
# called server-side, so the browser never needs these and the Docker image
# doesn't need them at build time.

# Supabase project: Settings → API.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# The Laravel API (../umbral-training-api). Locally: `composer dev` there.
API_URL=http://localhost:8000
